<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>WebGIS Map Viewer</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/lib/gis/5.1/esri/themes/light/main.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-sm app-navbar">
            <div class="container-fluid">

                <a class="navbar-brand app-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="22" height="22"
                             viewBox="0 0 24 24"
                             fill="none" stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3z" />
                            <path d="M9 3v15" />
                            <path d="M15 6v15" />
                        </svg>
                    </span>
                    <span>WebGIS</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-sm-center">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Map Viewer
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                About
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <main class="app-main" role="main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <span>WebGIS Map Viewer</span>
        <span class="footer-separator">|</span>
        <span>&copy; 2026 Municipal WebGIS</span>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>