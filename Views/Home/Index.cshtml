@{
    ViewData["Title"] = "Map Viewer";
}

<arcgis-map id="mapView"
            class="map-view"
            role="application"
            aria-label="Interactive WebGIS map">

    <!-- Top Left -->
    <arcgis-zoom slot="top-left"></arcgis-zoom>
    <arcgis-home id="homeWidget" slot="top-left"></arcgis-home>

    <!-- Top Right: Layer List -->
    <arcgis-expand slot="top-right"
                   group="top-right"
                   mode="floating"
                   expand-icon="layers"
                   expand-tooltip="Layer List">
        <arcgis-layer-list></arcgis-layer-list>
    </arcgis-expand>

    <!-- Top Right: Search (sources are configured in map.js) -->
    <arcgis-expand slot="top-right"
                   group="top-right"
                   mode="floating"
                   expand-icon="search"
                   expand-tooltip="جستجوی سریع">
        <arcgis-search id="parcelSearch"></arcgis-search>
    </arcgis-expand>

</arcgis-map>

@section Scripts {
    <script type="module" src="~/js/map.js" asp-append-version="true"></script>
}